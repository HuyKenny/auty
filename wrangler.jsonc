{
  // auty.cz — pure static site on Workers static assets. No Worker script: every request is a static-asset
  // request (free, unlimited); old URLs are handled by _redirects, misses get 404.html. Nothing here is billed.
  "name": "auty",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "auty.cz/*", "zone_name": "auty.cz" },
    { "pattern": "www.auty.cz/*", "zone_name": "auty.cz" }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false }
}
